# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=auth_service

# Database Migration Flags (set to "true" to enable)
# DROP_ALL_TABLES=true              # Drop ALL tables and recreate schema
# DROP_ALL_EXCEPT_USER=true         # Drop all tables except user-related
# DROP_ITEM_TABLES=true             # Drop only item-related tables
# DROP_ITEM_MODEL_ONLY=true         # Drop only Item model (not variants/details)

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id
GOOGLE_OAUTH_IOS_CLIENT_ID=your-ios-client-id
GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-android-client-id

# Server Configuration
PORT=3001

# External Services
NOTIFICATION_SERVICE_URL=http://localhost:3002

# Environment
APP_ENV=development
